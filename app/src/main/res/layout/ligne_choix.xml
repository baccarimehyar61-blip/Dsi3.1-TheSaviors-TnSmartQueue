<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne de choix (établissement, service ou agence) : une carte sur laquelle on peut cliquer -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/tsq_line"
    app:strokeWidth="1dp">

    <!-- Contenu de la carte : texte à gauche, petit texte rouge à droite -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Partie gauche : le titre et le sous-titre l'un sous l'autre -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Titre en gras (ex : « Municipalité »), écrit par le Kotlin -->
            <TextView
                android:id="@+id/tvChoiceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tsq_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Sous-titre en gris (ex : « 4 services disponibles »), écrit par le Kotlin -->
            <TextView
                android:id="@+id/tvChoiceSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/tsq_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Partie droite : texte rouge (ex : « → », « ~20 min » ou « Choisir ») -->
        <TextView
            android:id="@+id/tvChoiceRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E32636"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>