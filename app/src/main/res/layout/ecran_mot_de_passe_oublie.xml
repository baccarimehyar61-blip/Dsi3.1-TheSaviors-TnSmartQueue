<?xml version="1.0" encoding="utf-8"?>
<!-- Page « Mot de passe oublié » : tout est dans un ScrollView pour pouvoir défiler -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F4EE"
    android:fillViewport="true">

    <!-- Colonne verticale : les éléments sont empilés de haut en bas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Nom de l'application -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Tunisia Smart Queue"
            android:textColor="@color/tsq_red"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Titre de la page -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Mot de passe oublié"
            android:textColor="#14181F"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Phrase d'explication -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Saisissez votre e-mail pour récupérer votre compte."
            android:textColor="#667085" />

        <!-- Message de succès : caché au départ, affiché par le code Kotlin -->
        <TextView
            android:id="@+id/tvSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E7F5EC"
            android:padding="12dp"
            android:text="Si ce compte existe, un e-mail de récupération vient d'être envoyé."
            android:textColor="#157347"
            android:visibility="gone" />

        <!-- Champ e-mail : le cadre (tilEmail) affiche les erreurs sous le champ -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="E-mail"
            app:boxStrokeColor="@color/tsq_red"
            app:hintTextColor="@color/tsq_red">

            <!-- La zone où l'utilisateur écrit son e-mail -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bouton d'envoi -->
        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/tsq_red"
            android:text="Envoyer le lien"
            android:textColor="#FFFFFF" />

        <!-- Lien pour revenir à la page de connexion -->
        <TextView
            android:id="@+id/tvBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="← Retour à la connexion"
            android:textColor="@color/tsq_red" />
    </LinearLayout>
</ScrollView>